# Copy to .env.local. Values are public by design (they ship in the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Leave empty for local dev and tests: no widget, no token.
# SOURCE: https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=
# Contact form on the About page (V2-15). Set to 1 to show it; needs VITE_TURNSTILE_SITE_KEY too.
# Empty, 0 or false: the page shows "The contact form opens soon" and loads no Turnstile script.
# Turn on only after the contact-message Edge Function is deployed (V2-15 PR 2).
VITE_CONTACT_ENABLED=
